# Copy to .env (or export in your shell). NEVER commit the real file.
# The tool reads these from the process environment only; it does not auto-load .env files.

# Your xAI API key from https://console.x.ai  (leave the value empty here)
XAI_API_KEY=

# Model ID to use. See the model list in your xAI console / docs.
XAI_MODEL=grok-4.3

# OpenAI-compatible endpoint (default shown). Change only to use another compatible provider.
XAI_BASE_URL=https://api.x.ai/v1
